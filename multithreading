class A extends Thread {
    public void run() {
        for(int i=1;i<=5;i++)
            System.out.println("Thread A");
    }
}

class B extends Thread {
    public void run() {
        for(int i=1;i<=5;i++)
            System.out.println("Thread B");
    }
}

public class Test {
    public static void main(String[] args) {
        A t1 = new A();
        B t2 = new B();
        t1.start();
        t2.start();
    }
}
